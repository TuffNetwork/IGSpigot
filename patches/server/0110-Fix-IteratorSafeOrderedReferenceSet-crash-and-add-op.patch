diff --git a/src/main/java/io/papermc/paper/threadedregions/ParallelProcessor.java b/src/main/java/io/papermc/paper/threadedregions/ParallelProcessor.java
index e4a3338a61a6f0053e0e2a1a096d9dfd8305a0da..e46b40734399a3104892d9b6bd2199ca2752f396 100644
--- a/src/main/java/io/papermc/paper/threadedregions/ParallelProcessor.java
+++ b/src/main/java/io/papermc/paper/threadedregions/ParallelProcessor.java
@@ -106,47 +106,35 @@ public class ParallelProcessor {
 
         int poolSize = getPoolSize();
         int batchSize = (chunks.size() + poolSize - 1) / poolSize;
+        int batches = (chunks.size() + batchSize - 1) / batchSize; // Leaf - exact batch count
+        final CountDownLatch latch = new CountDownLatch(batches); // Leaf - replace busy-poll of Future::isDone
 
-        List<Future<?>> futures = new ArrayList<>(poolSize);
         for (int i = 0; i < chunks.size(); i += batchSize) {
             List<LevelChunk> batch = chunks.subList(i, Math.min(i + batchSize, chunks.size()));
-            Future<?> future = tickPool.submit(() -> {
-                for (LevelChunk chunk : batch) {
-                    try {
-                        world.tickChunk(chunk, randomTickSpeed);
-                    } catch (Throwable t) {
-                        LOGGER.error("Error in async chunk tick", t);
+            tickPool.execute(() -> {
+                try {
+                    for (LevelChunk chunk : batch) {
+                        try {
+                            world.tickChunk(chunk, randomTickSpeed);
+                        } catch (Throwable t) {
+                            LOGGER.error("Error in async chunk tick", t);
+                        }
                     }
+                } finally {
+                    latch.countDown();
                 }
-                return null;
             });
-            futures.add(future);
         }
 
-        boolean allDone;
-        do {
-            allDone = true;
-            for (int i = 0; i < futures.size(); i++) {
-                if (!futures.get(i).isDone()) {
-                    allDone = false;
-                    break;
-                }
-            }
-
-            if (!allDone) {
-                boolean pumped = world.getChunkSource().pollTask();
-                if (!pumped) {
+        // Leaf - drain main-thread chunk tasks while async batches finish
+        try {
+            while (!latch.await(0, TimeUnit.NANOSECONDS)) {
+                if (!world.getChunkSource().pollTask()) {
                     Thread.onSpinWait();
                 }
             }
-        } while (!allDone);
-
-        for (Future<?> future : futures) {
-            try {
-                future.get();
-            } catch (Exception e) {
-                LOGGER.error("Error in async chunk tick batch", e);
-            }
+        } catch (InterruptedException ie) {
+            Thread.currentThread().interrupt();
         }
     }
 
@@ -159,49 +147,38 @@ public class ParallelProcessor {
 
         int poolSize = getPoolSize();
         int chunkSize = (entities.size() + poolSize - 1) / poolSize;
+        int batches = (entities.size() + chunkSize - 1) / chunkSize; // Leaf
+        final CountDownLatch latch = new CountDownLatch(batches); // Leaf - replace busy-poll
 
-        List<Future<?>> futures = new ArrayList<>(poolSize);
         for (int i = 0; i < entities.size(); i += chunkSize) {
             List<Entity> chunk = entities.subList(i, Math.min(i + chunkSize, entities.size()));
-            Future<?> future = tickPool.submit(() -> {
-                for (Entity entity : chunk) {
-                    if (shouldTickSynchronously(entity)) continue;
-                    performAsyncEntityTick(world, entity);
+            tickPool.execute(() -> {
+                try {
+                    for (Entity entity : chunk) {
+                        if (shouldTickSynchronously(entity)) continue;
+                        performAsyncEntityTick(world, entity);
+                    }
+                } finally {
+                    latch.countDown();
                 }
             });
-            futures.add(future);
         }
 
+        // Sync-only entities tick on the main thread while async batches run
         for (Entity e : entities) {
             if (shouldTickSynchronously(e)) {
                 tickSynchronously(world, e);
             }
         }
 
-        boolean allDone;
-        do {
-            allDone = true;
-            for (int i = 0; i < futures.size(); i++) {
-                if (!futures.get(i).isDone()) {
-                    allDone = false;
-                    break;
-                }
-            }
-
-            if (!allDone) {
-                boolean pumped = world.getChunkSource().pollTask();
-                if (!pumped) {
+        try {
+            while (!latch.await(0, TimeUnit.NANOSECONDS)) {
+                if (!world.getChunkSource().pollTask()) {
                     Thread.onSpinWait();
                 }
             }
-        } while (!allDone);
-
-        for (Future<?> future : futures) {
-            try {
-                future.get();
-            } catch (Exception e) {
-                LOGGER.error("Error in async entity tick", e);
-            }
+        } catch (InterruptedException ie) {
+            Thread.currentThread().interrupt();
         }
     }
 
diff --git a/src/main/java/io/papermc/paper/util/maplist/IteratorSafeOrderedReferenceSet.java b/src/main/java/io/papermc/paper/util/maplist/IteratorSafeOrderedReferenceSet.java
index d9d7e6480ca40deb03284bf71a565dd9d2edff86..4efae2caac977d85116bacbf0b218313ef7a4937 100644
--- a/src/main/java/io/papermc/paper/util/maplist/IteratorSafeOrderedReferenceSet.java
+++ b/src/main/java/io/papermc/paper/util/maplist/IteratorSafeOrderedReferenceSet.java
@@ -8,6 +8,11 @@ import java.util.NoSuchElementException;
 
 public final class IteratorSafeOrderedReferenceSet<E> {
 
+    // Leaf start - crash recovery
+    private static final org.apache.logging.log4j.Logger LOGGER = org.apache.logging.log4j.LogManager.getLogger("IteratorSafeOrderedReferenceSet");
+    private static volatile boolean WARNED_CORRUPTED = false;
+    // Leaf end - crash recovery
+
     public static final int ITERATOR_FLAG_SEE_ADDITIONS = 1 << 0;
 
     protected final Reference2IntLinkedOpenHashMap<E> indexMap;
@@ -130,11 +135,33 @@ public final class IteratorSafeOrderedReferenceSet<E> {
     public synchronized boolean remove(final E element) {
         final int index = this.indexMap.removeInt(element);
         if (index >= 0) {
+            // Leaf start - bounds-check before touching listElements: parallel ticking
+            // can race here and we'd rather skip a stale entry than crash the world tick
+            if (index >= this.listElements.length) {
+                if (!WARNED_CORRUPTED) {
+                    WARNED_CORRUPTED = true;
+                    LOGGER.warn("IteratorSafeOrderedReferenceSet desync: index {} out of array bounds {} - recovering",
+                                index, this.listElements.length);
+                }
+                this.firstInvalidIndex = 0; // force full defrag rebuild
+                return true;
+            }
+            // Leaf end
             if (this.firstInvalidIndex < 0 || index < this.firstInvalidIndex) {
                 this.firstInvalidIndex = index;
             }
             if (this.listElements[index] != element) {
-                throw new IllegalStateException();
+                // Leaf start - do not crash the server on concurrency-induced desync.
+                // The map says we own this index but the list disagrees - the list and the
+                // map will be re-sync'd by the next defrag.
+                if (!WARNED_CORRUPTED) {
+                    WARNED_CORRUPTED = true;
+                    LOGGER.warn("IteratorSafeOrderedReferenceSet desync at index {} - recovering by forcing defrag",
+                                index);
+                }
+                this.firstInvalidIndex = 0;
+                return true;
+                // Leaf end
             }
             this.listElements[index] = null;
             if (this.allowSafeIteration() && this.iteratorCount == 0 && this.getFragFactor() >= this.maxFragFactor) {
@@ -146,7 +173,7 @@ public final class IteratorSafeOrderedReferenceSet<E> {
         return false;
     }
 
-    public boolean contains(final E element) {
+    public synchronized boolean contains(final E element) { // Leaf - thread-safe
         return this.indexMap.containsKey(element);
     }
 
@@ -168,7 +195,7 @@ public final class IteratorSafeOrderedReferenceSet<E> {
         return true;
     }
 
-    protected void defrag() {
+    protected synchronized void defrag() { // Leaf - fully thread-safe
         if (this.firstInvalidIndex < 0) {
             return; // nothing to do
         }
@@ -191,7 +218,14 @@ public final class IteratorSafeOrderedReferenceSet<E> {
             lastValidIndex = 0;
         } else {
             lastValidIndex = this.firstInvalidIndex;
-            final E key = backingArray[lastValidIndex - 1];
+            // Leaf start - defensively handle a null predecessor; can happen after a recovery
+            final E key = lastValidIndex > 0 && lastValidIndex - 1 < backingArray.length ? backingArray[lastValidIndex - 1] : null;
+            if (key == null) {
+                // Restart a full defrag next time around to be safe
+                this.firstInvalidIndex = 0;
+                return;
+            }
+            // Leaf end
             iterator = this.indexMap.reference2IntEntrySet().fastIterator(new Reference2IntMap.Entry<E>() {
                 @Override
                 public int getIntValue() {
@@ -225,30 +259,31 @@ public final class IteratorSafeOrderedReferenceSet<E> {
         //this.check();
     }
 
-    public E rawGet(final int index) {
+    public synchronized E rawGet(final int index) { // Leaf - thread-safe + bounds check
+        if (index < 0 || index >= this.listElements.length) return null;
         return this.listElements[index];
     }
 
-    public int size() {
+    public synchronized int size() { // Leaf - thread-safe
         // always returns the correct amount - listSize can be different
         return this.indexMap.size();
     }
 
-    public IteratorSafeOrderedReferenceSet.Iterator<E> iterator() {
+    public synchronized IteratorSafeOrderedReferenceSet.Iterator<E> iterator() { // Leaf - thread-safe
         return this.iterator(0);
     }
 
-    public IteratorSafeOrderedReferenceSet.Iterator<E> iterator(final int flags) {
+    public synchronized IteratorSafeOrderedReferenceSet.Iterator<E> iterator(final int flags) { // Leaf - thread-safe
         if (this.allowSafeIteration()) {
             ++this.iteratorCount;
         }
         return new BaseIterator<>(this, true, (flags & ITERATOR_FLAG_SEE_ADDITIONS) != 0 ? Integer.MAX_VALUE : this.listSize);
     }
 
-    public java.util.Iterator<E> unsafeIterator() {
+    public synchronized java.util.Iterator<E> unsafeIterator() { // Leaf - thread-safe
         return this.unsafeIterator(0);
     }
-    public java.util.Iterator<E> unsafeIterator(final int flags) {
+    public synchronized java.util.Iterator<E> unsafeIterator(final int flags) { // Leaf - thread-safe
         return new BaseIterator<>(this, false, (flags & ITERATOR_FLAG_SEE_ADDITIONS) != 0 ? Integer.MAX_VALUE : this.listSize);
     }
 
