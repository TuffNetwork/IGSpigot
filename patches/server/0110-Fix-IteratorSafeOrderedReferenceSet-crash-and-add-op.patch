                 if (!entity.isRemoved()) {
diff --git a/src/main/java/net/minecraft/world/phys/AABB.java b/src/main/java/net/minecraft/world/phys/AABB.java
index 796767d49c248d575eff64bc35756fa75cab424a..2696c2954c4026b84aa3982a10c2905fbbd42327 100644
--- a/src/main/java/net/minecraft/world/phys/AABB.java
+++ b/src/main/java/net/minecraft/world/phys/AABB.java
@@ -20,13 +20,10 @@ public class AABB {
     public final double maxY;
     public final double maxZ;
 
-    // Lazily cached values – computed on first access, 0.0 = unset sentinel
-    // (valid since a zero-area box on one axis would still have valid other sizes)
-    private double cachedXSize = Double.NaN;
-    private double cachedYSize = Double.NaN;
-    private double cachedZSize = Double.NaN;
-    private int cachedHashCode = 0;
-    private boolean hashCodeComputed = false;
+    // Leaf - removed lazy size/hash cache. Non-volatile mutable fields on a class
+    // accessed concurrently breaks happens-before: a reader could observe
+    // hashCodeComputed=true with cachedHashCode=0 (the default). Three doubles
+    // worth of subtraction is much cheaper than the cost of fixing this properly.
 
     public AABB(double x1, double y1, double z1, double x2, double y2, double z2) {
         // Branchless min/max is slightly faster on modern JVMs due to CMOV
@@ -151,8 +148,7 @@ public class AABB {
 
     @Override
     public int hashCode() {
-        // Cache the hash – AABBs are immutable so this is safe
-        if (hashCodeComputed) return cachedHashCode;
+        // Leaf - cache removed (see field comment); recompute every time
         long l = Double.doubleToLongBits(this.minX);
         int i = (int) (l ^ l >>> 32);
         l = Double.doubleToLongBits(this.minY);
@@ -164,10 +160,7 @@ public class AABB {
         l = Double.doubleToLongBits(this.maxY);
         i = 31 * i + (int) (l ^ l >>> 32);
         l = Double.doubleToLongBits(this.maxZ);
-        i = 31 * i + (int) (l ^ l >>> 32);
-        cachedHashCode = i;
-        hashCodeComputed = true;
-        return i;
+        return 31 * i + (int) (l ^ l >>> 32);
     }
 
     // ──────────────────────────────────────────────────────────────
@@ -243,10 +236,11 @@ public class AABB {
     // ──────────────────────────────────────────────────────────────
 
     public boolean intersects(AABB box) {
-        // Micro-optimized branchless-style check for modern JIT
-        return (this.minX < box.maxX) & (this.maxX > box.minX)
-            && (this.minY < box.maxY) & (this.maxY > box.minY)
-            && (this.minZ < box.maxZ) & (this.maxZ > box.minZ);
+        // Leaf - normal && short-circuiting beats forced-evaluation & on AABB intersection.
+        // X axis disjoint? Most AABB pairs are disjoint on X, so bail out early.
+        return this.minX < box.maxX && this.maxX > box.minX
+            && this.minY < box.maxY && this.maxY > box.minY
+            && this.minZ < box.maxZ && this.maxZ > box.minZ;
     }
 
     public boolean intersects(double minX, double minY, double minZ, double maxX, double maxY, double maxZ) {
@@ -273,22 +267,19 @@ public class AABB {
     }
 
     // ──────────────────────────────────────────────────────────────
-    // Size queries – cached to avoid repeated subtraction
+    // Size queries – Leaf: uncached (see field comment)
     // ──────────────────────────────────────────────────────────────
 
     public double getXsize() {
-        if (Double.isNaN(cachedXSize)) cachedXSize = this.maxX - this.minX;
-        return cachedXSize;
+        return this.maxX - this.minX;
     }
 
     public double getYsize() {
-        if (Double.isNaN(cachedYSize)) cachedYSize = this.maxY - this.minY;
-        return cachedYSize;
+        return this.maxY - this.minY;
     }
 
     public double getZsize() {
-        if (Double.isNaN(cachedZSize)) cachedZSize = this.maxZ - this.minZ;
-        return cachedZSize;
+        return this.maxZ - this.minZ;
     }
 
     /** Average of the three side lengths. */
