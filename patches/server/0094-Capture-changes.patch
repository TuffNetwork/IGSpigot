+package org.dreeam.leaf.config.modules.opt;
+
+import org.dreeam.leaf.config.ConfigInfo;
+import org.dreeam.leaf.config.EnumConfigCategory;
+import org.dreeam.leaf.config.IConfigModule;
+
+public class BlazinglySimpleFarmChecks implements IConfigModule {
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.PERFORMANCE;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "blazingly_simple_farm_checks";
+    }
+
+    @ConfigInfo(baseName = "enabled")
+    public static boolean enabled = false;
+
+    @ConfigInfo(baseName = "default_growth_speed")
+    public static float defaultGrowthSpeed = 1.0f;
+
+    @ConfigInfo(baseName = "moist_growth_speed")
+    public static float moistGrowthSpeed = 5.0f;
+
+    @ConfigInfo(baseName = "skip_middle_aging_stages_for_crops")
+    public static boolean skipMiddleAgingStagesForCrops = true;
+}
