From: octylphenol <272425610+octylphenol@users.noreply.github.com>
Date: Wed, 13 May 2026 20:47:30 -0400
Subject: [PATCH] Port FastMathMod math optimizations


diff --git a/src/main/java/net/minecraft/util/Mth.java b/src/main/java/net/minecraft/util/Mth.java
index 6a34354958aec331d6417087c4a7d24b49872f36..271efdbd0059bec89f0c4dc253f97378d40b3cd8 100644
--- a/src/main/java/net/minecraft/util/Mth.java
+++ b/src/main/java/net/minecraft/util/Mth.java
@@ -58,11 +58,13 @@ public class Mth {
     }
 
     public static int floor(float value) {
-        return (int) Math.floor(value); // Gale - use platform math functions
+        int i = (int) value;
+        return value < (float) i ? i - 1 : i;
     }
 
     public static int floor(double value) {
-        return (int) Math.floor(value); // Gale - use platform math functions
+        int i = (int) value;
+        return value < (double) i ? i - 1 : i;
     }
 
     public static long lfloor(double value) {
@@ -79,15 +81,21 @@ public class Mth {
     }
 
     public static int ceil(float value) {
-        return (int) Math.ceil(value); // Gale - use platform math functions
+        int i = (int) value;
+        return value > (float) i ? i + 1 : i;
     }
 
     public static int ceil(double value) {
-        return (int) Math.ceil(value); // Gale - use platform math functions
+        int i = (int) value;
+        return value > (double) i ? i + 1 : i;
     }
 
     public static int clamp(int value, int min, int max) {
-        return Math.min(Math.max(value, min), max);
+        if (value < min) {
+            return min;
+        } else {
+            return Math.min(value, max);
+        }
     }
 
     public static long clamp(long value, long min, long max) {
@@ -501,11 +509,11 @@ public class Mth {
     }
 
     public static float lerp(float delta, float start, float end) {
-        return start + delta * (end - start);
+        return Math.fma(delta, end - start, start);
     }
 
     public static double lerp(double delta, double start, double end) {
-        return start + delta * (end - start);
+        return Math.fma(delta, end - start, start);
     }
 
     public static double lerp2(double deltaX, double deltaY, double x0y0, double x1y0, double x0y1, double x1y1) {
@@ -626,8 +634,8 @@ public class Mth {
         return a * a + b * b;
     }
 
-    public static double length(double a, double b) {
-        return Math.sqrt(lengthSquared(a, b));
+    public static double length(double x, double y) {
+        return Math.sqrt(x * x + y * y);
     }
 
     public static double lengthSquared(double a, double b, double c) {
