diff --git a/src/main/java/net/minecraft/util/ZeroBitStorage.java b/src/main/java/net/minecraft/util/ZeroBitStorage.java
index 5ca2190235bbc13448f716f33e294503fbce1ebe..526353baf559689d92ce83efbace9510451d8fe0 100644
--- a/src/main/java/net/minecraft/util/ZeroBitStorage.java
+++ b/src/main/java/net/minecraft/util/ZeroBitStorage.java
@@ -10,7 +10,18 @@ public class ZeroBitStorage implements BitStorage {
     public static final long[] RAW = ArrayConstants.emptyLongArray; // Gale - JettPack - reduce array allocations
     private final int size;
 
-    public ZeroBitStorage(int size) {
+    // Leaf start - shared instances
+    private static final ZeroBitStorage INSTANCE_4096 = new ZeroBitStorage(4096);
+    private static final ZeroBitStorage INSTANCE_64 = new ZeroBitStorage(64);
+
+    public static ZeroBitStorage of(int size) {
+        if (size == 4096) return INSTANCE_4096;
+        if (size == 64) return INSTANCE_64;
+        return new ZeroBitStorage(size);
+    }
+    // Leaf end
+
+    private ZeroBitStorage(int size) { // Leaf - private constructor
         this.size = size;
     }
 
