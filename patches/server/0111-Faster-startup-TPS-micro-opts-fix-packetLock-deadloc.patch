diff --git a/src/main/java/io/papermc/paper/plugin/provider/source/DirectoryProviderSource.java b/src/main/java/io/papermc/paper/plugin/provider/source/DirectoryProviderSource.java
index 0846d3a904e470ae1920c5c8be3df9c5dfc3de27..8a1227b641e258a9209341e8e987df1892dba8d7 100644
--- a/src/main/java/io/papermc/paper/plugin/provider/source/DirectoryProviderSource.java
+++ b/src/main/java/io/papermc/paper/plugin/provider/source/DirectoryProviderSource.java
@@ -27,16 +27,35 @@ public class DirectoryProviderSource implements ProviderSource<Path, List<Path>>
             Files.createDirectories(context);
         }
 
-        final List<Path> files = new ArrayList<>();
-        this.walkFiles(context, path -> {
+        // Leaf start - parallel plugin file preparation.
+        // Each prepareContext opens the JAR to read its plugin name and walks the update
+        // directory; on a server with ~70 plugins this is the dominant pre-bootstrap cost.
+        // We preserve the file ordering by writing into a fixed-size results array then
+        // filtering nulls, so the downstream load order is identical to the sequential path.
+        final List<Path> jarPaths;
+        try (java.util.stream.Stream<Path> stream = Files.walk(context, 1, FileVisitOption.FOLLOW_LINKS)) {
+            jarPaths = stream.filter(this::isValidFile).sorted().toList();
+        }
+        final Path[] results = new Path[jarPaths.size()];
+        final java.util.concurrent.ConcurrentLinkedQueue<Throwable> errors = new java.util.concurrent.ConcurrentLinkedQueue<>();
+        java.util.stream.IntStream.range(0, jarPaths.size()).parallel().forEach(i -> {
+            final Path path = jarPaths.get(i);
             try {
-                files.add(FILE_PROVIDER_SOURCE.prepareContext(path));
+                results[i] = FILE_PROVIDER_SOURCE.prepareContext(path);
             } catch (IllegalArgumentException ignored) {
                 // Ignore illegal argument exceptions from jar checking
             } catch (final Exception e) {
-                LOGGER.error("Error preparing plugin context: " + e.getMessage(), e);
+                errors.add(e);
             }
         });
+        for (Throwable t : errors) {
+            LOGGER.error("Error preparing plugin context: " + t.getMessage(), t);
+        }
+        final List<Path> files = new ArrayList<>(results.length);
+        for (Path p : results) {
+            if (p != null) files.add(p);
+        }
+        // Leaf end - parallel plugin file preparation
         // Paper start - Remap plugins
         if (io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper != null) {
             return io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper.rewritePluginDirectory(files);
diff --git a/src/main/java/net/minecraft/network/protocol/PacketUtils.java b/src/main/java/net/minecraft/network/protocol/PacketUtils.java
index 3698bc741dcdb43e5fe8635108a8a8b566e24d9b..28bb756d3e7c5aac67eadf6b4edb7c928dabf223 100644
--- a/src/main/java/net/minecraft/network/protocol/PacketUtils.java
+++ b/src/main/java/net/minecraft/network/protocol/PacketUtils.java
@@ -43,21 +43,18 @@ public class PacketUtils {
     );
 
     private static boolean isAsyncSafe(Packet<?> packet) {
+        // Leaf - restricted to truly stateless packets. The previous list included movement,
+        // interact, client-command and teleport-accept packets which all read+write world state
+        // and frequently wait on chunk loads. Combined with the tick-wide packetLock that
+        // ServerGamePacketListenerImpl.tick() used to grab, that produced classic priority-
+        // inversion deadlocks: async handler held packetLock + waited on a chunk; main thread
+        // held nothing but was parked on packetLock and so could not pump the chunk task.
+        // Only network housekeeping packets stay async now.
         String name = packet.getClass().getSimpleName();
-        return name.contains("ServerboundClientInformationPacket") ||
-               name.contains("ServerboundCustomPayloadPacket") ||
-               name.contains("ServerboundKeepAlivePacket") ||
-               name.contains("ServerboundPingRequestPacket") ||
-               name.contains("ServerboundPongResponsePacket") ||
-               name.contains("ServerboundResourcePackPacket") ||
-               name.contains("ServerboundCookieResponsePacket") ||
-               name.contains("ServerboundSeenAdvancementsPacket") ||
-               name.contains("ServerboundMovePlayerPacket") ||
-               name.contains("ServerboundPlayerInputPacket") ||
-               name.contains("ServerboundSwingPacket") ||
-               name.contains("ServerboundInteractPacket") ||
-               name.contains("ServerboundClientCommandPacket") ||
-               name.contains("ServerboundAcceptTeleportationPacket");
+        return name.equals("ServerboundKeepAlivePacket") ||
+               name.equals("ServerboundPingRequestPacket") ||
+               name.equals("ServerboundPongResponsePacket") ||
+               name.equals("ServerboundCookieResponsePacket");
     }
 
     public static boolean isAsyncThread() {
