From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: cirsius <swagydorwhatever@gmail.com>
Date: Fri, 15 May 2026 13:04:48 -0500
Subject: [PATCH] Fix ServerChunkCache loadedChunkMap concurrent-writer crash,
 NearbyPlayers cache staleness


diff --git a/src/main/java/io/papermc/paper/util/player/NearbyPlayers.java b/src/main/java/io/papermc/paper/util/player/NearbyPlayers.java
index 7da6d481601e1a5a4b7e9d0c0d908ac4d7bc76fb..35402480ea71c05708953435b985ef3f8a4a31b8 100644
--- a/src/main/java/io/papermc/paper/util/player/NearbyPlayers.java
+++ b/src/main/java/io/papermc/paper/util/player/NearbyPlayers.java
@@ -46,6 +46,12 @@ public final class NearbyPlayers {
     private final TrackedChunk[] cacheValues = new TrackedChunk[CACHE_SIZE];
     private final long[] cacheKeys = new long[CACHE_SIZE];
     { java.util.Arrays.fill(this.cacheKeys, Long.MAX_VALUE); }
+    // Version-stamped invalidation: bump on every mutation so the thread-local
+    // cache can detect staleness without re-locking. Without this, a thread that
+    // observed `null` for chunk K once would keep observing null even after a
+    // player moved into K, breaking spawning logic. Memory barrier comes from
+    // the atomic; write-lock holders also publish their version under the lock.
+    private final java.util.concurrent.atomic.AtomicInteger cacheVersion = new java.util.concurrent.atomic.AtomicInteger();
 
     // Thread-local single-slot cache for very tight loops like NaturalSpawner
     private static final ThreadLocal<LastNearbyPlayers> localCache = ThreadLocal.withInitial(LastNearbyPlayers::new);
@@ -53,22 +59,29 @@ public final class NearbyPlayers {
     private static final class LastNearbyPlayers {
         long key = Long.MAX_VALUE;
         TrackedChunk value;
+        int version = -1; // Leaf - validated against owner's cacheVersion
+        NearbyPlayers owner; // Leaf - guard against being reused across worlds
     }
 
     private TrackedChunk getChunkInternal(long key) {
         LastNearbyPlayers local = localCache.get();
-        if (local.key == key) return local.value;
+        final int currentVersion = this.cacheVersion.get();
+        if (local.owner == this && local.version == currentVersion && local.key == key) {
+            return local.value;
+        }
 
         this.lock.readLock().lock();
         try {
             int hash = (int) it.unimi.dsi.fastutil.HashCommon.mix(key) & CACHE_MASK;
             if (this.cacheKeys[hash] == key) {
+                local.owner = this;
+                local.version = currentVersion;
                 local.key = key;
                 return local.value = this.cacheValues[hash];
             }
             TrackedChunk value = this.byChunk.get(key);
-            // We only update the local cache here to avoid write lock overhead for the shared cache
-            // The shared cache is updated in methods that already hold the write lock
+            local.owner = this;
+            local.version = currentVersion;
             local.key = key;
             return local.value = value;
         } finally {
@@ -249,15 +262,17 @@ public final class NearbyPlayers {
         protected void addCallback(final ServerPlayer parameter, final int chunkX, final int chunkZ) {
             final long chunkKey = CoordinateUtils.getChunkKey(chunkX, chunkZ);
 
+            final boolean isNew = !NearbyPlayers.this.byChunk.containsKey(chunkKey); // Leaf - detect new-chunk insertion
             TrackedChunk chunk = NearbyPlayers.this.byChunk.computeIfAbsent(chunkKey, (final long keyInMap) -> {
                 return new TrackedChunk();
             });
             chunk.addPlayer(parameter, this.type);
-            
+
             // Update shared cache since we already hold the write lock
             int hash = (int) it.unimi.dsi.fastutil.HashCommon.mix(chunkKey) & CACHE_MASK;
             NearbyPlayers.this.cacheKeys[hash] = chunkKey;
             NearbyPlayers.this.cacheValues[hash] = chunk;
+            if (isNew) NearbyPlayers.this.cacheVersion.incrementAndGet(); // Leaf - invalidate per-thread caches
         }
 
         @Override
@@ -278,6 +293,7 @@ public final class NearbyPlayers {
                     NearbyPlayers.this.cacheKeys[hash] = Long.MAX_VALUE;
                     NearbyPlayers.this.cacheValues[hash] = null;
                 }
+                NearbyPlayers.this.cacheVersion.incrementAndGet(); // Leaf - invalidate per-thread caches
             }
         }
     }
diff --git a/src/main/java/net/minecraft/server/level/ServerChunkCache.java b/src/main/java/net/minecraft/server/level/ServerChunkCache.java
index f65c113fcf573729b8bd0309d300e3197136ff4e..8fd239eaf2e9ffe578fe82469b6756e6911add98 100644
--- a/src/main/java/net/minecraft/server/level/ServerChunkCache.java
+++ b/src/main/java/net/minecraft/server/level/ServerChunkCache.java
@@ -111,11 +111,17 @@ public class ServerChunkCache extends ChunkSource {
     }
 
     public void addLoadedChunk(LevelChunk chunk) {
-        this.loadedChunkMapSeqLock.acquireWrite();
-        try {
-            this.loadedChunkMap.put(chunk.coordinateKey, chunk);
-        } finally {
-            this.loadedChunkMapSeqLock.releaseWrite();
+        // Leaf - the seqlock only fences readers; writers themselves were unsynchronized,
+        // and parallel chunk ticking → cascading block updates → unloadCallback can hit
+        // this concurrently. Long2ObjectOpenHashMap mutated from two threads corrupts its
+        // slot table and crashes the *next* op with ArrayIndexOutOfBoundsException -1.
+        synchronized (this.loadedChunkMap) {
+            this.loadedChunkMapSeqLock.acquireWrite();
+            try {
+                this.loadedChunkMap.put(chunk.coordinateKey, chunk);
+            } finally {
+                this.loadedChunkMapSeqLock.releaseWrite();
+            }
         }
 
         // rewrite cache if we have to
@@ -126,11 +132,14 @@ public class ServerChunkCache extends ChunkSource {
     }
 
     public void removeLoadedChunk(LevelChunk chunk) {
-        this.loadedChunkMapSeqLock.acquireWrite();
-        try {
-            this.loadedChunkMap.remove(chunk.coordinateKey);
-        } finally {
-            this.loadedChunkMapSeqLock.releaseWrite();
+        // Leaf - same writer-serialization fix as addLoadedChunk above
+        synchronized (this.loadedChunkMap) {
+            this.loadedChunkMapSeqLock.acquireWrite();
+            try {
+                this.loadedChunkMap.remove(chunk.coordinateKey);
+            } finally {
+                this.loadedChunkMapSeqLock.releaseWrite();
+            }
         }
 
         // rewrite cache if we have to
@@ -201,7 +210,12 @@ public class ServerChunkCache extends ChunkSource {
     public LevelChunk getChunkAtIfLoadedImmediately(int x, int z) {
         long k = ChunkPos.asLong(x, z);
 
-        if (io.papermc.paper.util.TickThread.isTickThread()) { // Paper - rewrite chunk system
+        // Leaf - direct same-thread check instead of TickThread.isTickThread(): async tick
+        // pool threads are TickThread instances too (since patch 0103), so the old check
+        // gave them the unguarded fast path and exposed them to torn map state during
+        // writer-side rehashes. Only the true MinecraftServer thread skips seqlock retry.
+        final net.minecraft.server.MinecraftServer srv = net.minecraft.server.MinecraftServer.getServer();
+        if (srv != null && srv.isSameThread()) {
             return this.getChunkAtIfLoadedMainThread(x, z);
         }
 
